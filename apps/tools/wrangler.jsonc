{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heartrush-tools",
  "account_id": "8c13ab7fc53dc5dfb06c42c05a0e58eb",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "src/server.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heartrush-tools",
      "database_id": "d5577aa4-3893-4912-b73b-6974e34dd73f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "heartrush-tools-images" }],
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": {
    "CROUTER_CLIENT_ID": "w5p61c34rt3p",
    "CROUTER_ISSUER": "https://account.northlight.ai",
    "APP_HOST": "tools.heartrush.party",
    "IMAGE_MODEL": "fal-ai/flux-pro/v1.1"
  },
  "routes": [{ "pattern": "tools.heartrush.party", "custom_domain": true }]
}
