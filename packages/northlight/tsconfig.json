{
  "include": [
    "src",
    "test"
  ],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "noEmit": true
  }
}
